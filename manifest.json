{
  "manifest_version": 3,
  "name": "Vuln Scanner Ultimate",
  "version": "5.0",
  "description": "Full-page passive + light active website vulnerability scanner",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webRequest",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Vuln Scanner"
  }
}
