{
  "manifest_version": 3,
  "name": "Vuln Scanner Ultimate",
  "version": "5.2.0",
  "minimum_chrome_version": "102",
  "description": "Evidence-led passive and light-active webpage security checks. Tool by a085.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webRequest",
    "tabs"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Vuln Scanner"
  }
}

