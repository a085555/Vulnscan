{
  "manifest_version": 3,
  "name": "Vuln Scanner Ultimate",
  "version": "6.1.0",
  "minimum_chrome_version": "102",
  "description": "Controlled passive and safe-active webpage security checks. Tool by a085.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webRequest",
    "tabs"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "action": {
    "default_title": "Open Vuln Scanner"
  }
}
