{
  "manifest_version": 3,
  "name": "Vuln Scanner Ultimate",
  "version": "6.2.0",
  "description": "Controlled passive and safe-active webpage security checks. Tool by a085.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webRequest",
    "tabs"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "finding-model.js",
      "url-utils.js",
      "scan-checks.js",
      "background.js"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "action": {
    "default_title": "Open Vuln Scanner"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "vulnscan@a085.dev",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
